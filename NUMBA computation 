from numba import jit
import numpy as np
@jit(nopython=True)
def F11_base_fast(n, prec=1e-12):
"""Numba-compiled version of base term"""
z = (n - 0.875) / np.e
w = lambert_w_fast(z, prec)
return 2 * np.pi * (n - 0.875) / w
@jit(nopython=True)
def lambert_w_fast(z, tol):
"""Fast Halley iteration"""
w = np.log(z) - np.log(np.log(z))
for _ in range(20): # Max iterations
ew = np.exp(w)
wew = w * ew
if abs(wew - z) < tol:
break
f = wew - z
fp = ew * (w + 1)
fpp = ew * (w + 2)
delta = f * fp / (fp*fp - 0.5*f*fpp)
w -= delta
return w