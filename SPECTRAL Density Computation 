from f11 import SpectralDensity
import numpy as np
density = SpectralDensity()
# Compute _F11(T) for T in [10, 1000]
T_values = np.linspace(10, 1000, 1000)
rho_values = density.rho_F11(T_values)
# Classical Weyl density for comparison
rho_weyl = density.rho_weyl(T_values)
# Compute relative difference
diff = np.abs(rho_values - rho_weyl) / rho_weyl
print(f"Max relative difference: {np.max(diff):.6e}")
