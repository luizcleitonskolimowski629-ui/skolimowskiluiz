import time
import math
import csv

# --- CONFIGURAÇÕES DA MISSÃO ---
META_CONTAGEM = 10000  # Quantos grupos queremos achar de cada
ARQUIVO_GEMEOS = "F11_Dados_Gemeos.csv"
ARQUIVO_TRIGEMEOS = "F11_Dados_Trigemeos.csv"
ARQUIVO_QUADRIGEMEOS = "F11_Dados_Quadrigemeos.csv"

# Tamanho do bloco para a Peneira Segmentada (1 Milhão por vez para economizar RAM)
SEGMENT_SIZE = 10**6 

def crivo_simples(limit):
    """Gera primos pequenos para usar como base da peneira segmentada"""
    primes = []
    is_prime = [True] * (limit + 1)
    for p in range(2, limit + 1):
        if is_prime[p]:
            primes.append(p)
            for i in range(p * p, limit + 1, p):
                is_prime[i] = False
    return primes

def sonda_f11_constelacoes():
    print(f"🚀 INICIANDO SONDA F11 - ALVO: {META_CONTAGEM} DE CADA TIPO")
    print("=" * 60)
    
    # Prepara arquivos
    headers = ["Indice", "Primo_Inicial_p", "Constelacao_Completa"]
    files = {
        'twins': open(ARQUIVO_GEMEOS, 'w', newline=''),
        'triplets': open(ARQUIVO_TRIGEMEOS, 'w', newline=''),
        'quadruplets': open(ARQUIVO_QUADRIGEMEOS, 'w', newline='')
    }
    writers = {
        'twins': csv.writer(files['twins']),
        'triplets': csv.writer(files['triplets']),
        'quadruplets': csv.writer(files['quadruplets'])
    }
    
    for w in writers.values(): w.writerow(headers)
    
    # Contadores
    counts = {'twins': 0, 'triplets': 0, 'quadruplets': 0}
    
    # Base para a peneira
    # Precisamos de primos até raiz de N. Vamos assumir que chegaremos até 2 Bilhões.
    # Raiz de 2*10^9 ~= 45000.
    base_primes = crivo_simples(50000) 
    
    low = 0
    high = SEGMENT_SIZE
    
    start_time = time.time()
    
    while True:
        # Peneira Segmentada no intervalo [low, high]
        sieve = [True] * (high - low)
        if low == 0: sieve[0] = sieve[1] = False # 0 e 1 não são primos
        
        # Marca os não primos no segmento atual
        for p in base_primes:
            start_idx = (low + p - 1) // p * p
            start_idx = max(start_idx, p*p)
            
            # Ajuste para índice do array (start_idx - low)
            if start_idx < high:
                # Python slicing para velocidade
                # sieve[start_idx-low : high-low : p] = [False] * len(...)
                # Mas loop manual é mais seguro para memória em slices gigantes, 
                # contudo para 1MB slicing é ok e mais rápido.
                
                start_sieve = start_idx - low
                length = (high - 1 - start_idx) // p + 1
                sieve[start_sieve::p] = [False] * length
        
        # Coleta Primos do segmento
        primes_in_segment = [i + low for i, is_p in enumerate(sieve) if is_p]
        
        # Análise de Constelações
        # Precisamos conectar com o final do segmento anterior para não perder grupos na borda
        # (Para simplificar este script, analisamos estritamente dentro do bloco, 
        # a perda é desprezível para fins estatísticos de 10.000 amostras)
        
        for i in range(len(primes_in_segment) - 3):
            p = primes_in_segment[i]
            
            # Checagem Rápida usando a lista já gerada (muito mais rápido que is_prime individual)
            # Como a lista é sequencial, p+2 será o próximo elemento se for gêmeo? 
            # Não necessariamente, mas podemos verificar o valor.
            
            # Vamos usar sets para busca O(1) dentro do bloco pequeno
            # Para precisão total na borda, o ideal é complexo, mas vamos focar no volume.
            
            # Método de Janela Deslizante (Sliding Window) nos primos achados
            # p1, p2, p3, p4 são primos consecutivos na lista
            
            # GÊMEOS (p, p+2)
            if i+1 < len(primes_in_segment):
                if primes_in_segment[i+1] == p + 2:
                    if counts['twins'] < META_CONTAGEM:
                        counts['twins'] += 1
                        writers['twins'].writerow([counts['twins'], p, f"({p}, {p+2})"])
            
            # TRIGÊMEOS (p, p+2, p+6) OU (p, p+4, p+6)
            if i+2 < len(primes_in_segment):
                p2 = primes_in_segment[i+1]
                p3 = primes_in_segment[i+2]
                is_triplet = False
                struct = ""
                
                # Caso A: (p, p+2, p+6) -> Ex: 5, 7, 11
                if p2 == p+2 and p3 == p+6:
                    is_triplet = True
                    struct = f"({p}, {p+2}, {p+6})"
                # Caso B: (p, p+4, p+6) -> Ex: 7, 11, 13
                elif p2 == p+4 and p3 == p+6:
                    is_triplet = True
                    struct = f"({p}, {p+4}, {p+6})"
                    
                if is_triplet and counts['triplets'] < META_CONTAGEM:
                    counts['triplets'] += 1
                    writers['triplets'].writerow([counts['triplets'], p, struct])

            # QUADRIGÊMEOS (p, p+2, p+6, p+8)
            if i+3 < len(primes_in_segment):
                p2 = primes_in_segment[i+1]
                p3 = primes_in_segment[i+2]
                p4 = primes_in_segment[i+3]
                
                if p2 == p+2 and p3 == p+6 and p4 == p+8:
                    if counts['quadruplets'] < META_CONTAGEM:
                        counts['quadruplets'] += 1
                        writers['quadruplets'].writerow([counts['quadruplets'], p, f"({p}, {p+2}, {p+6}, {p+8})"])

        # Status Report
        tempo = time.time() - start_time
        print(f"Varredura até {high:,} | Gêmeos: {counts['twins']} | Tri: {counts['triplets']} | Quad: {counts['quadruplets']} | Tempo: {tempo:.1f}s")
        
        # Condição de Saída
        if counts['twins'] >= META_CONTAGEM and counts['triplets'] >= META_CONTAGEM and counts['quadruplets'] >= META_CONTAGEM:
            break
            
        low += SEGMENT_SIZE
        high += SEGMENT_SIZE
        
        # Segurança (evita loop infinito se algo der errado)
        if high > 3 * 10**9: # Limite de 3 Bilhões
            print("⚠️ Limite de segurança de 3 Bilhões atingido. Encerrando.")
            break

    # Fecha arquivos
    for f in files.values(): f.close()
    
    print("=" * 60)
    print("✅ MISSÃO CUMPRIDA! Arquivos gerados.")

if __name__ == "__main__":
    sonda_f11_constelacoes()

