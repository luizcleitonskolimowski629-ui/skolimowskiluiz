import Mathlib.Analysis.SpecialFunctions.Log.Basic
import Mathlib.Analysis.SpecialFunctions.Exp
import Mathlib.Data.Complex.Basic
open Real
/--
Axiomatic definition of the principal branch of Lambert W for real x >= 0.
We assume the defining identity W(x) * exp(W(x)) = x.
-/
axiom LambertW : →
axiom LambertW_spec (x : ) (h : 0 x) :
(LambertW x) * exp (LambertW x) = x
axiom LambertW_pos (x : ) (h : 0 < x) :
0 < LambertW x