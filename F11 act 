# Função de progresso simples
def simple_progress(iterable, desc="Progress"):
    items = list(iterable)
    total = len(items)
    for i, item in enumerate(items, 1):
        if i % max(1, total // 20) == 0 or i == total:
            print(f"  {desc}: {i}/{total} ({100*i//total}%)")
        yield item

def primes_upto(N):
    """Gera todos os primos até N usando Crivo de Eratóstenes"""
    if N < 2:
        return []
    
    sieve = np.ones(N+1, dtype=bool)
    sieve[0] = sieve[1] = False
    
    for i in range(2, int(np.sqrt(N)) + 1):
        if sieve[i]:
            sieve[i*i:N+1:i] = False
    
    return np.where(sieve)[0].tolist()

