def gram_point_approx(n):
    """Aproximação do n-ésimo ponto de Gram"""
    arg = mpf(n) / e
    w = mp.lambertw(arg)
    return 2 * pi * mp.exp(w)

def T_base_gram(n):
    """T_base usando Gram points"""
    g_n = gram_point_approx(n)
    correction = pi / (2 * log(g_n))
    return g_n + correction

print("\n📐 Testando T_base:")
for n in range(1, 6):
    T_b = T_base_gram(n)
    T_real = zetazero(n).imag
    error = abs(T_b - T_real)
    print(f"  n={n}: erro={float(error):.2e}")

def T_osc_term(T, primes, max_primes=None):
    """Calcula T_osc = Σ sin(T log p) / √p"""
    if max_primes:
        primes = primes[:max_primes]
    
    T = mpf(T)
    result = mpf(0)
    
    for p in primes:
        p_mpf = mpf(p)
        term = sin(T * log(p_mpf)) / sqrt(p_mpf)
        result += term
    
    return result



def F11_solve(n, primes, max_iter=50, tol=1e-12, max_primes=5000):
    """Resolve T_n = T_base(n) + T_osc(T_n)"""
    T = T_base_gram(n)
    
    for iteration in range(max_iter):
        osc = T_osc_term(T, primes, max_primes)
        T_new = T_base_gram(n) + osc
        
        delta = abs(T_new - T)
        
        if delta < tol:
            return T_new, iteration+1, True
        
        T = T_new
    
    return T, max_iter, False



def test_F11_batch(n_max=100, max_primes=10000):
    """Testa F11 para zeros de 1 até n_max"""
    print(f"\n{'='*70}")
    print(f"TESTE EM BATCH: n=1 até n={n_max}")
    print(f"{'='*70}\n")
    
    print("🔢 Gerando primos...")
    primes = primes_upto(max_primes * 10)
    print(f"   Gerados {len(primes)} primos")
    
    results = []
    
    print("\n🔄 Calculando zeros...")
    for n in simple_progress(range(1, n_max+1), desc="Progresso"):
        T_f11, iters, converged = F11_solve(n, primes, max_primes=max_primes)
        T_real = zetazero(n).imag
        
        error_abs = abs(T_f11 - T_real)
        error_rel = error_abs / T_real
        
        results.append({
            'n': n,
            'T_f11': float(T_f11),
            'T_real': float(T_real),
            'error_abs': float(error_abs),
            'error_rel': float(error_rel),
            'iterations': iters,
            'converged': converged
        })
    
    return results


