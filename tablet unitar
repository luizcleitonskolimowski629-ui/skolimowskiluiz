Computes W(z) for an interval z using Halley’s method
with rigorous error bounds.
"""
# Initial guess using asymptotic expansion
lx = iv.log(z_interval)
llx = iv.log(lx)
w = lx - llx + llx/lx
# Iterate until convergence within interval width
for _ in range(5):
ew = iv.exp(w)
wew = w * ew
wew_z = wew - z_interval
