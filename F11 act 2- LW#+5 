import numpy as np
import matplotlib.pyplot as plt
from scipy.misc import derivative
from scipy.integrate import quad
import sympy as sp

class RiemannHypothesisBase:
    """
    Implementação completa da Base Numérica para teste da Hipótese de Riemann
    Todas as funções operam exclusivamente no eixo real
    """
    
    def __init__(self, precision_terms=10000):
        self.precision_terms = precision_terms
    
    def zeta_real(self, sigma, terms=None):
        """
        ζ(σ) no eixo real usando série alternada (Dirichlet Eta)
        Converge para σ > 0
        """
        if terms is None:
            terms = self.precision_terms
        
        if sigma <= 0:
            return np.nan
        
        result = 0.0
        for n in range(1, terms + 1):
            term = ((-1) ** (n - 1)) / (n ** sigma)
            result += term
        
        # Fator de correção para obter zeta a partir de eta
        correction = 1 / (1 - 2 ** (1 - sigma))
        return correction * result
    
    def zeta_prime_real(self, sigma, dx=1e-6):
        """
        ζ'(σ) via derivada numérica de alta precisão
        """
        return derivative(self.zeta_real, sigma, dx=dx, n=1)
    
    def F11_function(self, sigma):
        """
        Função estrutural F11 que estabiliza ζ(σ)
        F11(σ) = ζ(σ)·e^(-σ) + ζ'(σ)·e^(-2σ)
        """
        term1 = self.zeta_real(sigma) * np.exp(-sigma)
        term2 = self.zeta_prime_real(sigma) * np.exp(-2 * sigma)
        return term1 + term2
    
    def E_operator(self, sigma, dx=1e-6):
        """
        Operador de Estabilidade E(σ) = d/dσ[F11(σ)]
        """
        return derivative(self.F11_function, sigma, dx=dx, n=1)
    
    def S_function(self, sigma):
        """
        Função de Sensibilidade S(σ) = F11(σ) / E(σ)
        """
        F11_val = self.F11_function(sigma)
        E_val = self.E_operator(sigma)
        
        if abs(E_val) < 1e-15:
            return np.nan
        
        return F11_val / E_val
    
    def I_invariant(self, sigma, dx=1e-6):
        """
        Invariante Numérico I(σ) = d/dσ[ζ(σ)/ζ'(σ)]
        """
        def ratio(s):
            zeta_val = self.zeta_real(s)
            zeta_prime_val = self.zeta_prime_real(s)
            if abs(zeta_prime_val) < 1e-15:
                return np.nan
            return zeta_val / zeta_prime_val
        
        return derivative(ratio, sigma, dx=dx, n=1)
    
    def scan_stability(self, sigma_range=(0.3, 20.0), num_points=1000):
        """
        Varredura completa da estabilidade numérica na base RH
        """
        sigma_values = np.linspace(sigma_range[0], sigma_range[1], num_points)
        
        results = {
            'sigma': sigma_values,
            'zeta': [],
            'zeta_prime': [],
            'F11': [],
            'E': [],
            'S': [],
            'I': []
        }
        
        for sigma in sigma_values:
            try:
                z = self.zeta_real(sigma)
                zp = self.zeta_prime_real(sigma)
                f11 = self.F11_function(sigma)
                e = self.E_operator(sigma)
                s = self.S_function(sigma)
                i_val = self.I_invariant(sigma)
                
                results['zeta'].append(z)
                results['zeta_prime'].append(zp)
                results['F11'].append(f11)
                results['E'].append(e)
                results['S'].append(s)
                results['I'].append(i_val)
            except:
                results['zeta'].append(np.nan)
                results['zeta_prime'].append(np.nan)
                results['F11'].append(np.nan)
                results['E'].append(np.nan)
                results['S'].append(np.nan)
                results['I'].append(np.nan)
        
        return results
    
    def detect_anomalies(self, results, threshold=1e10):
        """
        Detecta anomalias numéricas que indicariam zeros fora da linha crítica
        """
        anomalies = []
        
        for i, sigma in enumerate(results['sigma']):
            # Verifica se alguma função explode ou se torna instável
            values = [
                abs(results['zeta'][i]) if not np.isnan(results['zeta'][i]) else 0,
                abs(results['zeta_prime'][i]) if not np.isnan(results['zeta_prime'][i]) else 0,
                abs(results['F11'][i]) if not np.isnan(results['F11'][i]) else 0,
                abs(results['E'][i]) if not np.isnan(results['E'][i]) else 0,
                abs(results['S'][i]) if not np.isnan(results['S'][i]) else 0,
                abs(results['I'][i]) if not np.isnan(results['I'][i]) else 0
            ]
            
            if any(v > threshold for v in values if v != 0):
                anomalies.append({
                    'sigma': sigma,
                    'zeta': results['zeta'][i],
                    'F11': results['F11'][i],
                    'S': results['S'][i],
                    'I': results['I'][i]
                })
        
        return anomalies



def run_comprehensive_tests():
    """Executa testes abrangentes da Base Numérica RH"""
    
    print("🧪 INICIANDO TESTES DA BASE NUMÉRICA RH")
    print("=" * 60)
    
    # Instancia a base
    rh_base = RiemannHypothesisBase(precision_terms=5000)
    
    # Teste 1: Varredura de estabilidade
    print("1. Varredura de estabilidade numérica...")
    results = rh_base.scan_stability(sigma_range=(0.5, 10.0), num_points=500)
    
    # Teste 2: Detecção de anomalias
    print("2. Detecção de anomalias...")
    anomalies = rh_base.detect_anomalies(results, threshold=1e5)
    
    # Teste 3: Pontos críticos conhecidos
    print("3. Verificação em pontos críticos...")
    critical_points = [1.0, 1.5, 2.0, 0.5]
    for point in critical_points:
        try:
            z = rh_base.zeta_real(point)
            print(f"   ζ({point}) = {z:.6f}")
        except:
            print(f"   ζ({point}) = Indefinido")
    
    # Resultados
    print("=" * 60)
    print("📊 RESULTADOS DOS TESTES:")
    print(f"   • Total de pontos analisados: {len(results['sigma'])}")
    print(f"   • Anomalias detectadas: {len(anomalies)}")
    
    if len(anomalies) == 0:
        print("   ✅ NENHUMA INSTABILIDADE DETECTADA")
        print("   → Base numérica compatível com RH")
    else:
        print("   ❌ ANOMALIAS ENCONTRADAS:")
        for anomaly in anomalies[:5]:  # Mostra apenas as primeiras 5
            print(f"     σ = {anomaly['sigma']:.3f}, I = {anomaly['I']:.3e}")
    
    return rh_base, results, anomalies

def plot_rh_base_functions(results):
    """Gera gráficos completos da Base Numérica RH"""
    
    fig, axes = plt.subplots(2, 3, figsize=(15, 10))
    fig.suptitle('Base Numérica para Hipótese de Riemann - Análise Completa', fontsize=16)
    
    # ζ(σ)
    axes[0,0].plot(results['sigma'], results['zeta'], 'b-', linewidth=2)
    axes[0,0].set_title('ζ(σ) - Função Zeta Real')
    axes[0,0].set_xlabel('σ')
    axes[0,0].set_ylabel('ζ(σ)')
    axes[0,0].grid(True, alpha=0.3)
    
    # ζ'(σ)
    axes[0,1].plot(results['sigma'], results['zeta_prime'], 'r-', linewidth=2)
    axes[0,1].set_title("ζ'(σ) - Derivada da Zeta")
    axes[0,1].set_xlabel('σ')
    axes[0,1].set_ylabel("ζ'(σ)")
    axes[0,1].grid(True, alpha=0.3)
    
    # F11(σ)
    axes[0,2].plot(results['sigma'], results['F11'], 'g-', linewidth=2)
    axes[0,2].set_title('F11(σ) - Função Estrutural')
    axes[0,2].set_xlabel('σ')
    axes[0,2].set_ylabel('F11(σ)')
    axes[0,2].grid(True, alpha=0.3)
    
    # E(σ)
    axes[1,0].plot(results['sigma'], results['E'], 'm-', linewidth=2)
    axes[1,0].set_title('E(σ) - Operador de Estabilidade')
    axes[1,0].set_xlabel('σ')
    axes[1,0].set_ylabel('E(σ)')
    axes[1,0].grid(True, alpha=0.3)
    
    # S(σ)
    axes[1,1].plot(results['sigma'], results['S'], 'c-', linewidth=2)
    axes[1,1].set_title('S(σ) - Função Sensibilidade')
    axes[1,1].set_xlabel('σ')
    axes[1,1].set_ylabel('S(σ)')
    axes[1,1].grid(True, alpha=0.3)
    
    # I(σ)
    axes[1,2].plot(results['sigma'], results['I'], 'orange', linewidth=2)
    axes[1,2].set_title('I(σ) - Invariante Numérico')
    axes[1,2].set_xlabel('σ')
    axes[1,2].set_ylabel('I(σ)')
    axes[1,2].grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.show()

